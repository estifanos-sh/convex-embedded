{
  "format": "convex-embedded-wire-surface/v1",
  "endpoints": {
    "pull": "embedded:pull",
    "push": "embedded:push",
    "upload": "embedded:upload"
  },
  "pull": {
    "identity": { "fields": ["contractIds", "kind"] },
    "live": { "fields": ["args", "functionName", "kind", "runtime"] },
    "checkpoint": {
      "fields": [
        "args",
        "checkpointId",
        "cursor",
        "epoch",
        "field",
        "functionName",
        "headSeq",
        "kind",
        "rowId",
        "runtime",
        "table"
      ]
    },
    "cursor": {
      "fields": ["args", "boundary", "cursor", "functionName", "kind", "path", "runtime"]
    }
  },
  "push": {
    "mutation": {
      "fields": [
        "acknowledgeReplayId",
        "afterImages",
        "argRefs",
        "args",
        "clientId",
        "crdt",
        "functionName",
        "inserts",
        "kind",
        "logicalFingerprint",
        "mutationId",
        "mutationTime",
        "randomSeed",
        "reads",
        "replayId",
        "resultHash",
        "revisionCheckpoints",
        "runtime",
        "schedules",
        "uploads"
      ],
      "optional": ["acknowledgeReplayId"]
    },
    "acknowledge": { "fields": ["clientId", "kind", "replayId", "runtime"] },
    "blob": {
      "fields": [
        "bytes",
        "chunk",
        "chunkHash",
        "chunks",
        "clientId",
        "hash",
        "kind",
        "ordinal",
        "runtime",
        "scope"
      ]
    },
    "checkpointScope": {
      "fields": ["bytes", "checkpointId", "clientId", "hash", "kind", "responseToken", "runtime"]
    },
    "checkpoint": {
      "fields": [
        "checkpointId",
        "clientId",
        "content",
        "kind",
        "projectionHash",
        "responseToken",
        "runtime",
        "scopeToken",
        "throughSeq"
      ],
      "optional": ["scopeToken"]
    }
  },
  "upload": {
    "fields": ["contentType", "localStorageId", "runtime", "sha256", "size"],
    "optional": ["contentType"],
    "constraints": {
      "localStorageId": "nonempty",
      "sha256": "lowercase-hex-64",
      "size": "safe-nonnegative-integer",
      "runtime": "exact-current"
    }
  },
  "errors": ["EMBEDDED_PROTOCOL_MISMATCH"],
  "validators": {
    "pullArgs": "sha256:cc81796d2d30d32fa64be68592a486f58283454a52408343716b0e56d6ac7ce0",
    "pushArgs": "sha256:ccd6cd0e3908e9572536c378160f023d36f201b390d0e2dea68f4617972d0ead",
    "uploadArgs": "sha256:f9f72a6eccc11a1a71248996c02345459dfe1cf72659efe102d4f27a9d871ede",
    "pullReturns": "sha256:33d84c77816b0d323fad396b87ac3ca48c42820af0c7c11d44c2bdcbaa3c2a81",
    "pushReturns": "sha256:c0f5da23bc0e9036a06e2618a14f507ee4332669e4ccb4d0a66f29615497a1a9",
    "uploadReturns": "sha256:c05bca28b5c0c0f682a56982774d482fc0647d009e429e3f452e2337c5782986"
  },
  "discriminators": {
    "pull": ["identity", "live", "checkpoint", "cursor"],
    "push": ["mutation", "acknowledge", "blob", "checkpointScope", "checkpoint"]
  }
}
