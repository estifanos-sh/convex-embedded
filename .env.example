# Convex deployment URL shared by every demo and test surface.
# Get it from `npx convex dashboard`, or run `vp run setup`.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Deployment slug written by the Convex CLI; cross-checks the URL above.
CONVEX_DEPLOYMENT=

# Remote authorization tests read the fixture admin key from
# packages/embedded/tests/fixture/.env.local, never this file.
# CONVEX_EMBEDDED_FIXTURE_ADMIN_KEY=
