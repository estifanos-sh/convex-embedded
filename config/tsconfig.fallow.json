{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@estifanos-sh/convex-embedded/browser": ["./../packages/embedded/src/browser/index.ts"],
      "@estifanos-sh/convex-embedded/bundler": ["./../packages/embedded/src/bundler/index.ts"],
      "@estifanos-sh/convex-embedded/convex.config": [
        "./../packages/embedded/src/component/convex.config.ts"
      ],
      "@estifanos-sh/convex-embedded/convex.config.js": [
        "./../packages/embedded/src/component/convex.config.ts"
      ],
      "@estifanos-sh/convex-embedded/devtools": ["./../packages/embedded/src/devtools/index.ts"],
      "@estifanos-sh/convex-embedded/devtools/vite": [
        "./../packages/embedded/src/devtools/vite.ts"
      ],
      "@estifanos-sh/convex-embedded/expo": ["./../packages/embedded/src/expo/index.ts"],
      "@estifanos-sh/convex-embedded/internal/local": [
        "./../packages/embedded/src/internal/local.ts"
      ],
      "@estifanos-sh/convex-embedded/internal/text": ["./../packages/embedded/src/text/field.ts"],
      "@estifanos-sh/convex-embedded/local": ["./../packages/embedded/src/local.ts"],
      "@estifanos-sh/convex-embedded/metro": ["./../packages/embedded/src/metro.ts"],
      "@estifanos-sh/convex-embedded/node": ["./../packages/embedded/src/node/index.ts"],
      "@estifanos-sh/convex-embedded/schema": ["./../packages/embedded/src/tables.ts"],
      "@estifanos-sh/convex-embedded/server": ["./../packages/embedded/src/server/index.ts"],
      "@estifanos-sh/convex-embedded/unplugin": ["./../packages/embedded/src/unplugin.ts"],
      "@estifanos-sh/convex-embedded/values": ["./../packages/embedded/src/values.ts"],
      "@estifanos-sh/convex-embedded/vite": ["./../packages/embedded/src/vite.ts"],
      "@estifanos-sh/convex-embedded/_generated/component.js": [
        "./../packages/embedded/src/component/_generated/component.ts"
      ]
    }
  },
  "include": ["../convex/**/*.ts", "../local/**/*.ts", "../packages/embedded/src/**/*.ts"],
  "exclude": [
    "../convex/_generated/**",
    "../packages/embedded/dist/**",
    "../packages/embedded/tests/bench/.out/**"
  ]
}
