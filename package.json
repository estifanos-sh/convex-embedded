{
  "name": "embedded",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run @convex-dev/embedded#style && vp run @convex-dev/embedded#build && vp run @convex-dev/embedded#test:node && vp test && vp run build:browser:vite",
    "style": "vp run @convex-dev/embedded#style",
    "test:unit": "vp run @convex-dev/embedded#test:unit",
    "test:runtime": "vp run @convex-dev/embedded#test:runtime",
    "test:storage": "vp run @convex-dev/embedded#test:storage",
    "test:server": "vp run @convex-dev/embedded#test:server",
    "test:remote": "vp run @convex-dev/embedded#test:remote",
    "test:browser": "vp run @convex-dev/embedded#test:browser",
    "test:metal": "vp run @convex-dev/embedded#test:metal",
    "test:surface": "vp run @convex-dev/embedded#test:surface",
    "bench": "vp run @convex-dev/embedded#bench",
    "bench:smoke": "vp run @convex-dev/embedded#bench:smoke",
    "bench:compare": "vp run @convex-dev/embedded#bench:compare",
    "bench:browser:startup": "vp run @convex-dev/embedded#bench:browser:startup",
    "bench:browser:scale": "vp run @convex-dev/embedded#bench:browser:scale",
    "bench:browser:scale:goal": "vp run @convex-dev/embedded#bench:browser:scale:goal",
    "bench:browser:scale:matrix": "vp run @convex-dev/embedded#bench:browser:scale:matrix",
    "bench:browser:scale:manual": "vp run @convex-dev/embedded#bench:browser:scale:manual",
    "bench:metal:scale": "vp run @convex-dev/embedded#bench:metal:scale",
    "bench:metal:scale:goal": "vp run @convex-dev/embedded#bench:metal:scale:goal",
    "bench:metal:scale:matrix": "vp run @convex-dev/embedded#bench:metal:scale:matrix",
    "bench:metal:scale:manual": "vp run @convex-dev/embedded#bench:metal:scale:manual",
    "bench:browser:scale:stress": "vp run @convex-dev/embedded#bench:browser:scale:stress",
    "bench:browser:scale:stress:manual": "vp run @convex-dev/embedded#bench:browser:scale:stress:manual",
    "bench:metal:scale:stress": "vp run @convex-dev/embedded#bench:metal:scale:stress",
    "bench:metal:scale:stress:manual": "vp run @convex-dev/embedded#bench:metal:scale:stress:manual",
    "bench:scale": "vp run @convex-dev/embedded#bench:scale",
    "bench:scale:goal": "vp run @convex-dev/embedded#bench:scale:goal",
    "bench:scale:matrix": "vp run @convex-dev/embedded#bench:scale:matrix",
    "bench:scale:manual": "vp run @convex-dev/embedded#bench:scale:manual",
    "bench:scale:stress": "vp run @convex-dev/embedded#bench:scale:stress",
    "bench:scale:stress:manual": "vp run @convex-dev/embedded#bench:scale:stress:manual",
    "deploy:demo": "vp run @convex-dev/embedded#build && vpx convex deploy --cmd 'vp run build:browser:vite' --cmd-url-env-var-name VITE_CONVEX_URL && vp exec static-hosting deploy --skip-build --skip-convex --dist demos/browser/vite/dist",
    "upload:demo": "vp run upload:browser:vite",
    "dev:convex": "vpx convex dev",
    "dev:browser:vite": "pnpm --filter @convex-dev/embedded-demo-browser-vite dev",
    "build:browser:vite": "pnpm --filter @convex-dev/embedded-demo-browser-vite build",
    "preview:browser:vite": "pnpm --filter @convex-dev/embedded-demo-browser-vite preview",
    "upload:browser:vite": "vp exec static-hosting upload --dist demos/browser/vite/dist",
    "prepare": "vp config"
  },
  "dependencies": {
    "@convex-dev/embedded": "workspace:*",
    "@convex-dev/migrations": "catalog:",
    "@convex-dev/static-hosting": "^0.1.4",
    "@types/node": "catalog:",
    "convex": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
