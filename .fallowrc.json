{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/embedded/src/bundler/index.ts",
    "packages/embedded/src/browser/embedded.ts",
    "packages/embedded/src/browser/index.ts",
    "packages/embedded/src/component/crdt.ts",
    "packages/embedded/src/component/crdt/checkpoint.ts",
    "packages/embedded/src/component/crdt/field.ts",
    "packages/embedded/src/component/crdt/payload.ts",
    "packages/embedded/src/component/convex.config.ts",
    "packages/embedded/src/component/_generated/component.ts",
    "packages/embedded/src/component/file.ts",
    "packages/embedded/src/component/mutation.ts",
    "packages/embedded/src/component/protocol.ts",
    "packages/embedded/src/component/remote/client.ts",
    "packages/embedded/src/component/rev.ts",
    "packages/embedded/src/component/schema.ts",
    "packages/embedded/src/devtools/index.ts",
    "packages/embedded/src/devtools/vite.ts",
    "packages/embedded/src/client.ts",
    "packages/embedded/src/storage/binding.ts",
    "packages/embedded/src/node/index.ts",
    "packages/embedded/src/server/index.ts",
    "packages/embedded/src/unplugin.ts",
    "packages/embedded/src/values.ts",
    "packages/embedded/src/vite.ts",
    "packages/embedded/tests/unit/**/*.ts",
    "packages/embedded/tests/storage/**/*.ts",
    "packages/embedded/tests/runtime/**/*.ts",
    "packages/embedded/tests/server/**/*.ts",
    "packages/embedded/tests/remote/**/*.ts",
    "packages/embedded/tests/surface/**/*.ts",
    "packages/embedded/tests/browser/**/*.ts",
    "packages/embedded/tests/bench/**/*.ts",
    "packages/embedded/tests/metal/**/*.ts",
    "packages/embedded/tests/fixture/convex/**/*.ts"
  ],
  "dynamicallyLoaded": ["packages/embedded/src/browser/worker.ts"],
  "workspaces": {
    "patterns": ["packages/*", "demos/*", "demos/browser/*"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@napi-rs/cli", "binaryen", "~convex"],
  "ignoreDependencyOverrides": [{ "package": "@voidzero-dev/vite-plus" }],
  "ignorePatterns": ["vendor/**", "dist/**", "**/_generated/**", "tests/bench/.out/**"],
  "ignoreUnresolvedImports": [
    "**/wasm/index.wasm",
    "**/thread/browser-worker.mjs",
    "**/browser-embedded.mjs",
    "**/dist/component/schema.mjs",
    "**/tests/bench/.out/**"
  ]
}
