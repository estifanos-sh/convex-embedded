{
  "name": "@convex-dev/embedded",
  "version": "0.0.0",
  "description": "Embedded runtime and Convex server wrapper for local-first Convex apps.",
  "files": [
    "dist/*-*.cjs",
    "dist/*-*.d.cts",
    "dist/*-*.d.mts",
    "dist/*-*.mjs",
    "dist/browser-embedded.d.mts",
    "dist/browser-embedded.mjs",
    "dist/browser.d.mts",
    "dist/browser.mjs",
    "dist/bundler.d.mts",
    "dist/bundler.mjs",
    "dist/component",
    "dist/devtools",
    "dist/expo",
    "dist/internal",
    "dist/native",
    "dist/node.d.mts",
    "dist/node.mjs",
    "dist/metro.cjs",
    "dist/metro.d.cts",
    "dist/metro.d.mts",
    "dist/metro.mjs",
    "dist/server.d.mts",
    "dist/server.mjs",
    "dist/schema.cjs",
    "dist/schema.d.cts",
    "dist/schema.d.mts",
    "dist/schema.mjs",
    "dist/thread",
    "dist/unplugin.d.mts",
    "dist/unplugin.mjs",
    "dist/values.cjs",
    "dist/values.d.cts",
    "dist/values.d.mts",
    "dist/values.mjs",
    "dist/vite.d.mts",
    "dist/vite.mjs",
    "dist/wasm",
    "native",
    "android",
    "ios",
    "expo-module.config.json",
    "ConvexEmbeddedNative.podspec",
    "src"
  ],
  "type": "module",
  "exports": {
    "./bundler": {
      "types": "./dist/bundler.d.mts",
      "import": "./dist/bundler.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.mts",
      "import": "./dist/devtools/index.mjs"
    },
    "./devtools/vite": {
      "types": "./dist/devtools/vite.d.mts",
      "import": "./dist/devtools/vite.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./expo": {
      "types": "./dist/expo/index.d.mts",
      "import": "./dist/expo/index.mjs"
    },
    "./metro": {
      "import": {
        "types": "./dist/metro.d.mts",
        "default": "./dist/metro.mjs"
      },
      "require": {
        "types": "./dist/metro.d.cts",
        "default": "./dist/metro.cjs"
      }
    },
    "./values": {
      "import": {
        "types": "./dist/values.d.mts",
        "default": "./dist/values.mjs"
      },
      "require": {
        "types": "./dist/values.d.cts",
        "default": "./dist/values.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.mts",
        "default": "./dist/schema.mjs"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./convex.config": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.mts",
      "import": "./dist/component/convex.config.js",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.mts",
      "import": "./dist/component/convex.config.js",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.mts",
      "import": "./dist/component/_generated/component.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:ts": "vp pack",
    "prepack": "vp run build",
    "mobile": "node scripts/mobile.ts",
    "mobile:android": "node scripts/mobile.ts android",
    "mobile:compile:android": "node scripts/mobilecompile.ts android",
    "mobile:compile:ios": "node scripts/mobilecompile.ts ios",
    "mobile:ios": "node scripts/mobile.ts ios",
    "mobile:verify": "node scripts/mobile.ts verify",
    "native": "node scripts/native.ts",
    "size": "node scripts/size.ts",
    "test:node": "node scripts/node/smoke.ts",
    "wasm": "node scripts/wasm.ts",
    "style": "node scripts/style.ts",
    "dev": "vp pack --watch",
    "test": "vp pack && vp test run --config vite/tests.ts --project unit --project storage --project server --project surface && vp test run --config vite/tests.ts --project runtime --maxWorkers=1",
    "test:unit": "vp test run --config vite/tests.ts --project unit",
    "test:runtime": "vp test run --config vite/tests.ts --project runtime --maxWorkers=1",
    "test:storage": "vp test run --config vite/tests.ts --project storage",
    "test:server": "vp test run --config vite/tests.ts --project server",
    "test:remote": "vp test run --config vite/tests.ts --project remote",
    "test:browser": "node scripts/browser.ts",
    "test:metal": "vp pack && node scripts/wasm.ts && vp test run --config vite/tests.ts --project metal",
    "test:surface": "vp test run --config vite/tests.ts --project surface",
    "bench": "node scripts/bench.ts",
    "bench:compare": "node scripts/bench.ts --compare tests/bench/baseline.json",
    "bench:browser:startup": "node scripts/bench.ts --browser-startup",
    "bench:browser:remote": "node scripts/bench.ts --browser-remote",
    "bench:browser:scale": "node scripts/bench.ts --browser-scale",
    "bench:browser:scale:goal": "node scripts/bench.ts --browser-scale-goal",
    "bench:browser:scale:manual": "node scripts/bench.ts --browser-scale-matrix --manual",
    "bench:browser:scale:matrix": "node scripts/bench.ts --browser-scale-matrix",
    "bench:browser:scale:stress": "node scripts/bench.ts --browser-scale-stress",
    "bench:browser:scale:stress:manual": "node scripts/bench.ts --browser-scale-stress --manual",
    "bench:memory": "node scripts/bench.ts --layer memory",
    "bench:native": "node scripts/bench.ts --layer native",
    "bench:metal:reconnect": "node scripts/bench.ts --metal-reconnect-volume",
    "bench:metal:scale": "node scripts/bench.ts --metal-scale",
    "bench:metal:scale:goal": "node scripts/bench.ts --metal-scale-goal",
    "bench:metal:scale:manual": "node scripts/bench.ts --metal-scale-matrix --manual",
    "bench:metal:scale:matrix": "node scripts/bench.ts --metal-scale-matrix",
    "bench:metal:scale:stress": "node scripts/bench.ts --metal-scale-stress",
    "bench:metal:scale:stress:manual": "node scripts/bench.ts --metal-scale-stress --manual",
    "bench:scale": "node scripts/bench.ts --scale",
    "bench:scale:goal": "node scripts/bench.ts --scale-goal",
    "bench:scale:manual": "node scripts/bench.ts --scale-matrix --manual",
    "bench:scale:matrix": "node scripts/bench.ts --scale-matrix",
    "bench:scale:stress": "node scripts/bench.ts --scale-stress",
    "bench:scale:stress:manual": "node scripts/bench.ts --scale-stress --manual",
    "bench:smoke": "node scripts/bench.ts --smoke",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "catalog:",
    "convex-helpers": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@convex-dev/migrations": "catalog:",
    "@emnapi/core": "catalog:",
    "@emnapi/runtime": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "binaryen": "catalog:",
    "convex": "catalog:",
    "expo": "catalog:",
    "expo-crypto": "catalog:",
    "fast-check": "catalog:",
    "playwright": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.42.1",
    "expo": ">=54.0.0",
    "expo-crypto": ">=15.0.0",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lint": "catalog:",
    "@tanstack/devtools": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "codemirror": "catalog:",
    "solid-js": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
